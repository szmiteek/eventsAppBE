<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0" author="adrian">
        <addColumn tableName="offer">
            <column name="event_type" type="JSON"/>
            <column name="main_table_type" type="VARCHAR(255)"/>
            <column name="main_table_seats" type="VARCHAR(255)"/>
            <column name="guests_table_type" type="VARCHAR(255)"/>
            <column name="appetizers_on_table" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="decoration_type" type="JSON"/>
            <column name="flowers_type" type="VARCHAR(255)"/>
            <column name="colors" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>

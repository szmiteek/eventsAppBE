<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0" author="adrian">
        <addColumn tableName="event">
            <column name="decoration_description" type="TEXT"/>
        </addColumn>
    </changeSet>

    <!-- An element now belongs either to an offer or to an event, so offer_id can no longer be required. -->
    <changeSet id="1" author="adrian">
        <dropNotNullConstraint tableName="event_element" columnName="offer_id" columnDataType="INT"/>
    </changeSet>

    <changeSet id="2" author="adrian">
        <addColumn tableName="event_element">
            <column name="event_id" type="INT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="event_element" baseColumnNames="event_id"
                                 constraintName="fk_event_element_event"
                                 referencedTableName="event" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>

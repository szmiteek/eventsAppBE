# Wzor pliku .env dla wdrozenia produkcyjnego.
# Skopiuj na serwerze do .env i uzupelnij. .env jest w .gitignore.
#
#   cp .env.example .env && chmod 600 .env
#
# Wartosci generuj na serwerze, nie przeklejaj skadkolwiek:
#   openssl rand -base64 32
#   openssl rand -base64 48

# Domena obslugiwana przez Caddy. Musi wskazywac na ten serwer,
# zanim uruchomisz kontenery - inaczej Let's Encrypt nie wystawi certyfikatu.
DOMAIN=weddingo.pl

# Baza danych. Hasla generowane, nie slownikowe.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=weddingo
MYSQL_PASSWORD=

# Podpisywanie tokenow sesji:  openssl rand -base64 48
JWT_SECRET=

# Szyfrowanie refresh tokenow Google (AES-256):  openssl rand -base64 32
# UWAGA: zmiana tego klucza unieważnia zapisane polaczenia z Google -
# kazdy tenant musialby podlaczyc konto od nowa. Wygeneruj raz.
APP_MAIL_ENCRYPTION_KEY=

# Dane klienta OAuth z Google Cloud Console.
# W konsoli dopisz do Authorized redirect URIs:
#   https://weddingo.pl/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

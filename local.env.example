# Skopiuj do local.env i uzupełnij. local.env jest w .gitignore — nie trafia do repo.
#
# Uruchamiając z IntelliJ zamiast ./run-local.sh, ustaw dodatkowo profil:
#   SPRING_PROFILES_ACTIVE=dev
# Bez niego CORS dla ng serve (:4200) jest wyłączony i frontend nie dogada się z API.

# Baza danych — bez tych zmiennych aplikacja nie wstanie.
# Cudzysłów jest konieczny: bez niego powłoka potraktuje "&" jako operator tła
# i zmienna w ogóle się nie ustawi.
SPRING_DATASOURCE_URL="jdbc:mysql://localhost:3306/events?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=user

# Sekret podpisujący tokeny sesji. Wygeneruj własny:  openssl rand -base64 48
# Produkcja musi mieć inny niż development.
JWT_SECRET=

# Klucz szyfrujący refresh tokeny Google (AES-256).
# Wygeneruj raz:  openssl rand -base64 32
# UWAGA: po zmianie klucza zapisane połączenia trzeba podłączyć od nowa.
APP_MAIL_ENCRYPTION_KEY=

# Dane z Google Cloud Console -> Credentials -> OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Musi być identyczne z "Authorized redirect URI" w Google Cloud Console
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_URI=http://localhost:4200/settings
